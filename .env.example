# Hyperagent 配置示例文件
# 复制此文件为 .env 并填入真实的 API 密钥

# ============================================================================
# LLM 配置 (支持任何 OpenAI 兼容 API)
# ============================================================================

# LLM 提供商: openai, ollama, qwen, glm, minimax
LLM_PROVIDER=openai

# 模型名称
LLM_MODEL=gpt-4o

# API 密钥 (必需)
LLM_API_KEY=sk-your-api-key-here

# 自定义端点 (可选,默认使用提供商的官方端点)
# LLM_BASE_URL=https://api.openai.com/v1

# ============================================================================
# OpenAI 配置示例
# ============================================================================
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1

# ============================================================================
# Ollama 配置示例 (本地推理)
# ============================================================================
# LLM_PROVIDER=ollama
# LLM_MODEL=llama2
# LLM_BASE_URL=http://localhost:11434
# LLM_API_KEY=

# ============================================================================
# 通义千问 (Qwen) 配置示例
# ============================================================================
# LLM_PROVIDER=qwen
# LLM_MODEL=qwen-turbo
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ============================================================================
# 智谱 AI (GLM) 配置示例
# ============================================================================
# LLM_PROVIDER=glm
# LLM_MODEL=glm-4
# LLM_API_KEY=...
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ============================================================================
# MiniMax 配置示例
# ============================================================================
# LLM_PROVIDER=minimax
# LLM_MODEL=abab6.5s-chat
# LLM_API_KEY=...
# LLM_BASE_URL=https://api.minimax.chat/v1

# ============================================================================
# 自动研究配置 (可选)
# ============================================================================

# 自动推送到 GitHub (true/false, 默认: true)
# RESEARCH_AUTO_PUSH=true

# 安全模式: 只测试不提交 (true/false, 默认: false)
# RESEARCH_DRY_RUN=false

# 严格模式: 测试 100% 通过才接受 (true/false, 默认: false)
# RESEARCH_STRICT=false

# 研究迭代次数 (默认: 5)
# RESEARCH_ITERATIONS=5

# 启用 Web 搜索 (true/false, 默认: true)
# RESEARCH_WEB=true

# ============================================================================
# 进化引擎配置 (可选)
# ============================================================================

# 进化迭代次数 (默认: 5)
# ITERATIONS=5
