{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Williw Desktop",
  "version": "0.1.1",
  "identifier": "com.williw.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://asset.localhost; connect-src ipc: http://ipc.localhost http://localhost:* https://localhost:*"
    },
    "windows": [
      {
        "title": "Williw - Decentralized Training",
        "width": 1150,
        "height": 700,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "hiddenTitle": false,
        "titleBarStyle": "Visible",
        "devtools": true
      }
    ],
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../dist/*": ".",
      "../dist/assets/*": "assets/"
    },
"icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/williw.png"
    ]
  },
  "plugins": {}
}
